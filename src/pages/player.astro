---
import "../styles/wos-plus-player.css";
import WosGameView from "../components/WosGameView.astro";
---

<WosGameView
  view="player"
  viewLabel="Player"
  title="WoS+ | Words on Stream Plus - Player"
  description="WoS+ | Words on Stream Plus - Player - An enhanced spectator interface for Words on Stream with Twitch chat integration and customizable settings."
  keywords="clarkio, words on stream, wos, twitch, streaming, helper, wordsonstream, tool, wos plus, player"
  defaultTheme="sticker-pop"
/>

<script>
  import { mountViewController } from "../scripts/view-controller";

  mountViewController("player");
</script>

<style>
  /* Player-only: a fullscreen 16:9 stage. The streamer view is an OBS
     overlay and sizes itself from the source instead. These are :global
     because they target the document and the layout wrapper, neither of
     which this page renders itself. */
  :global(html, body) {
    width: 100%;
    height: 100%;
  }

  :global(body) {
    margin: 0;
  }

  :global(.wrapper) {
    max-width: 100%;
    width: 100%;
    min-height: 100vh;
    margin: 0;
    padding: 0;
  }
</style>
