---
import WosBaseLayout from "../../layouts/WosBaseLayout.astro";
import Twitch from "../../components/Icons/Twitch.astro";
import { BOT_COMMAND_GROUPS } from "../../data/bot-commands";

// The full WoS+ Bot command reference. The bot's !help reply links here
// (https://wosplus.com/bot/commands) because the whole list is too long to
// read in a Twitch chat window. The data lives in src/data/bot-commands.ts.
---

<WosBaseLayout
  title="WoS+ Bot Commands | Twitch Chatbot for Words on Stream"
  description="Every WoS+ Bot chat command for Words on Stream: start and continue games, define words, see clear streaks, and the settings broadcasters and moderators can change."
  keywords="words on stream, wos, chatbot, twitch bot, wos plus bot, commands, help, define, continue, restart, moderator"
>
  <div class="sp-bot">
    <!-- ===================== Nav ===================== -->
    <header class="sp-nav">
      <a href="/" class="sp-brand">WoS<span class="sp-brand-plus">+</span></a>
      <nav class="sp-nav-links">
        <a href="/">Home</a>
        <a href="/bot">Bot</a>
        <a href="/bot/setup" class="sp-nav-launch">Setup</a>
      </nav>
    </header>

    <!-- ===================== Hero ===================== -->
    <section class="sp-hero">
      <div class="sp-hero-content">
        <span class="sp-hero-badge">
          <Twitch width={16} height={16} />
          Type these in Twitch chat
        </span>
        <h1 class="sp-hero-title">
          BOT <span class="sp-hero-accent">COMMANDS</span>
        </h1>
        <p class="sp-hero-sub">
          Everything WoS+ Bot answers to. Words in <code>&lt;angle brackets&gt;</code>
          are required, words in <code>[square brackets]</code> are optional.
          Want one command explained in chat? Send <code>!help</code> and its name,
          like <code>!help define</code>.
        </p>
        <nav class="sp-jump" aria-label="Command groups">
          {BOT_COMMAND_GROUPS.map((group) => (
            <a href={`#${group.id}`}>{group.title}</a>
          ))}
        </nav>
      </div>
    </section>

    <!-- ===================== Command groups ===================== -->
    {BOT_COMMAND_GROUPS.map((group) => (
      <section id={group.id} class="sp-section">
        <h2 class="sp-group-title">{group.title}</h2>
        <p class="sp-group-blurb">{group.blurb}</p>
        <div class="sp-commands">
          {group.commands.map((cmd) => (
            <article class="sp-command" data-bot-command={cmd.name}>
              <div class="sp-command-head">
                <code class="sp-command-usage">{cmd.usage}</code>
                {cmd.modsOnly && <span class="sp-badge">Broadcaster &amp; mods</span>}
              </div>
              {cmd.aliases.length > 0 && (
                <span class="sp-command-alias">
                  {cmd.aliases.length === 1 ? "alias" : "aliases"}:{" "}
                  {cmd.aliases.map((alias, i) => (
                    <>{i > 0 && ", "}<code>!{alias}</code></>
                  ))}
                </span>
              )}
              <p class="sp-command-desc">{cmd.description}</p>
              {cmd.notes && (
                <ul class="sp-command-notes">
                  {cmd.notes.map((note) => <li>{note}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}

    <!-- ===================== CTA ===================== -->
    <section class="sp-cta">
      <div class="sp-cta-content">
        <h2 class="sp-cta-title">Not in your channel yet?</h2>
        <p class="sp-cta-sub">
          Add WoS+ Bot to your Twitch channel, then follow the setup steps.
        </p>
        <div class="sp-cta-row">
          <a
            href="https://wos-plus-bot.onrender.com/auth"
            class="sp-btn sp-btn-cyan"
            target="_blank"
            rel="noopener"
          >
            <Twitch width={18} height={18} />
            Add Bot to Your Channel
          </a>
          <a href="/bot/setup" class="sp-btn sp-btn-yellow">Setup Steps →</a>
        </div>
      </div>
    </section>

    <!-- ===================== Footer ===================== -->
    <footer class="sp-footer">
      <a href="/" class="sp-footer-brand">WoS<span class="sp-footer-plus">+</span></a>
      <div class="sp-footer-links">
        <a href="/">Home</a>
        <a href="/bot">Bot</a>
        <a href="/streamer">Streamer View</a>
        <a href="https://wos.gg" target="_blank" rel="noopener">Words on Stream</a>
      </div>
      <div class="sp-footer-by">
        Made with 💜 by
        <a href="https://twitch.tv/clarkio" target="_blank" rel="noopener">clarkio</a>
      </div>
    </footer>
  </div>
</WosBaseLayout>

<style>
  .sp-bot {
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--sp-bg);
    font-family: var(--font-ui);
    color: var(--sp-ink);
  }

  /* ===================== Nav ===================== */
  .sp-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 32px;
    background: var(--sp-cyan);
    color: var(--sp-cyan-ink);
  }

  .sp-brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    color: var(--sp-bg-deep);
    text-decoration: none;
  }

  .sp-brand-plus {
    color: var(--sp-purple);
  }

  .sp-nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }

  .sp-nav-links a {
    color: var(--sp-cyan-ink);
    text-decoration: none;
  }

  .sp-nav-launch {
    padding: 9px 20px;
    border-radius: 999px;
    background: var(--sp-bg-deep);
    color: #fff !important;
    box-shadow: 3px 3px 0 var(--sp-cyan-shadow);
    transition: transform 0.12s ease;
  }

  .sp-nav-launch:hover {
    transform: translate(-1px, -1px);
  }

  /* ===================== Hero ===================== */
  .sp-hero {
    padding: 54px 32px 10px;
    max-width: 1240px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sp-hero-content {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sp-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--sp-purple);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 22px;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
  }

  .sp-hero-badge :global(svg) {
    fill: #fff;
  }

  .sp-hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 68px;
    line-height: 0.95;
    letter-spacing: -2px;
    color: #fff;
    text-shadow: 5px 5px 0 var(--sp-purple);
  }

  .sp-hero-accent {
    color: var(--sp-yellow);
    text-shadow: 5px 5px 0 var(--sp-bg-deep);
  }

  .sp-hero-sub {
    margin: 26px 0 0;
    font-size: 19px;
    line-height: 1.5;
    color: var(--sp-ink-muted);
    max-width: 560px;
    font-weight: 500;
  }

  .sp-hero-sub code {
    background: rgba(255, 255, 255, 0.12);
    color: var(--sp-yellow);
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* ===================== Jump links ===================== */
  .sp-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 26px;
  }

  .sp-jump a {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--sp-bg-deep);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--sp-purple);
  }

  .sp-jump a:hover {
    transform: translate(-1px, -1px);
  }

  /* ===================== Command groups ===================== */
  .sp-section {
    max-width: 1040px;
    margin: 0 auto;
    padding: 40px 32px 10px;
    scroll-margin-top: 16px;
  }

  .sp-group-title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    color: #fff;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .sp-group-blurb {
    margin: 0 0 22px;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--sp-ink-muted);
    max-width: 760px;
  }

  .sp-commands {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 22px;
  }

  .sp-command {
    padding: 22px 24px;
    border-radius: 18px;
    background: #fff;
    color: var(--sp-bg-deep);
    text-align: left;
    box-shadow: 5px 5px 0 var(--sp-purple);
    min-width: 0;
  }

  .sp-command:nth-child(4n + 2) { box-shadow: 5px 5px 0 var(--sp-pink); }
  .sp-command:nth-child(4n + 3) { box-shadow: 5px 5px 0 var(--sp-cyan); }
  .sp-command:nth-child(4n + 4) { box-shadow: 5px 5px 0 var(--sp-yellow); }

  .sp-command-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .sp-command-usage {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    background: var(--sp-purple);
    padding: 0.35rem 0.7rem;
    border-radius: 0.5rem;
    overflow-wrap: anywhere;
  }

  .sp-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--sp-pink);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 12px;
    white-space: nowrap;
  }

  .sp-command-alias {
    display: block;
    font-size: 0.85rem;
    color: rgba(22, 2, 39, 0.6);
    margin-bottom: 10px;
    font-weight: 600;
  }

  .sp-command-alias code,
  .sp-command-notes code {
    font-family: var(--font-mono);
  }

  .sp-command-desc {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
    color: rgba(22, 2, 39, 0.78);
  }

  .sp-command-notes {
    margin: 10px 0 0;
    padding-left: 18px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(22, 2, 39, 0.62);
  }

  /* ===================== Buttons ===================== */
  .sp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 30px;
    border-radius: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 0.12s ease;
  }

  .sp-btn:hover {
    transform: translate(-1px, -1px);
  }

  .sp-btn:active {
    transform: translate(2px, 2px);
  }

  .sp-btn-cyan {
    background: var(--sp-cyan);
    color: var(--sp-cyan-ink);
    box-shadow: 5px 5px 0 var(--sp-cyan-shadow);
  }

  .sp-btn-cyan :global(svg) {
    fill: var(--sp-cyan-ink);
  }

  .sp-btn-yellow {
    background: var(--sp-yellow);
    color: var(--sp-bg-deep);
    box-shadow: 5px 5px 0 var(--sp-yellow-shadow);
  }

  /* ===================== CTA ===================== */
  .sp-cta {
    max-width: 940px;
    margin: 0 auto;
    padding: 20px 32px 70px;
  }

  .sp-cta-content {
    text-align: center;
    padding: 50px 34px;
    background: var(--sp-purple);
    border-radius: 24px;
    box-shadow: 8px 8px 0 var(--sp-bg-deep);
  }

  .sp-cta-title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    color: #fff;
  }

  .sp-cta-sub {
    margin: 0 0 28px;
    font-size: 17px;
    color: #e3d4ff;
  }

  .sp-cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ===================== Footer ===================== */
  .sp-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26px 34px;
    background: var(--sp-bg-darkest);
    flex-wrap: wrap;
    gap: 16px;
  }

  .sp-footer-brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: #fff;
    text-decoration: none;
  }

  .sp-footer-plus {
    color: var(--sp-cyan);
  }

  .sp-footer-links {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 14px;
    font-weight: 500;
  }

  .sp-footer-links a {
    color: var(--sp-ink-muted);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sp-footer-links a:hover {
    color: var(--sp-cyan);
  }

  .sp-footer-by {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    color: var(--sp-ink-dim);
  }

  .sp-footer-by a {
    color: var(--sp-cyan);
    text-decoration: none;
    font-weight: 600;
  }

  /* ===================== Responsive ===================== */
  @media (max-width: 760px) {
    .sp-hero {
      padding: 36px 22px 12px;
    }

    .sp-hero-title {
      font-size: 46px;
    }

    .sp-nav {
      padding: 16px 20px;
    }

    .sp-nav-links {
      gap: 14px;
      font-size: 14px;
    }

    .sp-section {
      padding: 32px 20px 6px;
    }

    .sp-group-title {
      font-size: 24px;
    }

    .sp-commands {
      grid-template-columns: 1fr;
    }

    .sp-cta-title {
      font-size: 26px;
    }

    .sp-footer {
      flex-direction: column;
      text-align: center;
    }

    .sp-btn {
      justify-content: center;
    }
  }
</style>
